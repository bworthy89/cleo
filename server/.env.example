# Existing — now used as fallbacks
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_PRONUNCIATION_DICT_ID=
ELEVENLABS_PRONUNCIATION_DICT_VERSION=

# Genius enrichment (unchanged)
GENIUS_ACCESS_TOKEN=

# New — Self-hosted providers (primary)
OLLAMA_BASE_URL=https://ollama.yourdomain.com
OLLAMA_MODEL=llama3.1:8b
ORPHEUS_BASE_URL=https://tts.yourdomain.com
ORPHEUS_VOICE=tara
ORPHEUS_MAX_TOKENS=2048

# Provider config
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=2000

# Optional: override TTS cache directory (default: ~/.cache/cleo-tts/)
# TTS_CACHE_DIR=/path/to/cache

# Broadcast segment storage backend: "local" (default) or "r2"
STORAGE_BACKEND=local

# Local backend — override cache dir (default: server/.broadcast-cache)
# BROADCAST_CACHE_DIR=
# Dev: URL where segment MP3s are reachable from the device
BROADCAST_ASSET_BASE_URL=http://localhost:3001

# R2 backend (Cloudflare) — required when STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional: when set, manifests return public URLs at this base
# (enable the r2.dev subdomain or a custom domain first). Unset = signed URLs.
R2_PUBLIC_BASE_URL=

# Curator-only publish gate — comma-separated emails
CURATOR_EMAILS=

# Last.fm — track tags and artist bio for enrichment; optional
LASTFM_API_KEY=
