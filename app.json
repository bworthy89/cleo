{
  "expo": {
    "name": "ONAY",
    "slug": "cleo",
    "version": "1.2.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/65e6f716-8b20-415c-9827-cfcef3e2c8ae",
      "enabled": true,
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "cleo",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0807"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.worthymedia.cleo",
      "buildNumber": "64",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "ONAY uses Apple Music to play your playlists with AI-powered radio hosting.",
        "NSPhotoLibraryUsageDescription": "ONAY may access your photo library to set a profile picture.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "deploymentTarget": "16.2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0907",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.worthymedia.cleo",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-font",
      "react-native-video",
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "./plugins/firebase-modular-headers",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "16.2"
          }
        }
      ],
      "@sentry/react-native/expo",
      "expo-updates",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65e6f716-8b20-415c-9827-cfcef3e2c8ae"
      }
    },
    "owner": "bworthy89"
  }
}
