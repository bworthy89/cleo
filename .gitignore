# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# git worktrees
.worktrees/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.development
.env.production
server/.env
server/.env.development
server/.env.production
firebase-service-account.json

# typescript
*.tsbuildinfo

# native platform — bare workflow (custom Swift in ONAYWidgets + modules/expo-music-kit)
# Track ios/ so EAS cloud builds include the widget target + custom pbxproj settings.
/android/
/ios/Pods/
/ios/build/
/ios/DerivedData/
/ios/.xcode.env.local
/ios/**/xcuserdata/
/ios/**/*.xcuserstate
# GoogleService-Info.plist is safe to commit (contains no private keys)
firebase-debug.log

# TTS audio cache
server/.cache/

# VoxCPM listening test outputs (personal A/B audio samples)
/voxcpm-samples/

# Obsidian vault — personal workspace (specs/plans stay tracked)
docs/.obsidian/
docs/daily/
docs/ideas/

# Operational details (hostnames, server paths, routine IDs, internal IPs).
# Kept locally in OPERATIONS.md, never committed.
/OPERATIONS.md

# Pre-publication audit artifacts (raw findings include literal secrets)
/audit-report/
/audit-before-public.sh

# Loose RTF / scratch files at repo root — historical leak vector
/*.rtf

# Internal planning briefs (untracked-only, never commit)
/cleo-*-brief.md
/cleo-*-plan.md

# Migration archives + scratch
/v2-migration/
/v2-migration*.zip
/local voice tests.md
/Untitled.rtf

# Stray Firebase config sometimes downloaded to repo root by mistake.
# The real one lives at ios/ONAY/GoogleService-Info.plist.
/GoogleService-Info.plist

# Project-scoped MCP server config — contains live API tokens
# (Vast.ai / Discord / etc.). Each contributor should set up their own.
/.mcp.json

# Local npm config (legacy-peer-deps preference, possible registry tokens)
/.npmrc

# Xcode archive output (~3.5 GB of binary build products)
/build/

# Claude Code / Superpowers / Playwright MCP local session state
/.claude/
/.superpowers/
/.playwright-mcp/
