# dependencies
node_modules/

# git worktrees
.worktrees/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
.env.development
.env.production
server/.env
server/.env.development
server/.env.production
firebase-service-account.json

# typescript
*.tsbuildinfo

# native platform — bare workflow (custom Swift in ONAYWidgets + modules/expo-music-kit)
# Track ios/ so EAS cloud builds include the widget target + custom pbxproj settings.
/android/
/ios/Pods/
/ios/build/
/ios/DerivedData/
/ios/.xcode.env.local
/ios/**/xcuserdata/
/ios/**/*.xcuserstate
# GoogleService-Info.plist is safe to commit (contains no private keys)
firebase-debug.log

# TTS audio cache
server/.cache/

# VoxCPM listening test outputs (personal A/B audio samples)
/voxcpm-samples/
