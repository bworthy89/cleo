# Mobile client public env vars (Expo SDK 55).
# IMPORTANT: every EXPO_PUBLIC_* value gets bundled into the app and is
# visible to anyone with the .ipa. Never put secrets here.
#
# Server-side secrets (Gemini, Cartesia, Genius, Firebase admin, etc.)
# go in `server/.env` — see `server/.env.example`.

# Broadcast server base URL.
#   dev (LAN):     http://<your-LAN-IP>:3001
#   dev → staging: https://<your-staging-host>
#   prod:          https://<your-api-host>
EXPO_PUBLIC_API_URL=http://localhost:3001

# Sentry DSN for crash + error reporting (optional in dev).
EXPO_PUBLIC_SENTRY_DSN=
